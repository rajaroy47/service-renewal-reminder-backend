PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/client_renewal_reminder
CORS_ORIGIN=http://localhost:5173

# ---- Authentication (dashboard login) ----
# Generate your own random secret, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
TOKEN_EXPIRES_IN=12h
# Used ONLY to create the very first admin login, the first time the server
# ever starts against an empty "users" collection. Change the password from
# inside the dashboard afterwards (Change Password button).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123

# SMTP settings for reminder emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youremail@gmail.com
# For Gmail, use a 16-character App Password, not your normal password
SMTP_PASS=your_app_password
MAIL_FROM="Your Company" <youremail@gmail.com>

# ---- Employee renewal-alert email ----
# This is the FIXED inbox of the employee who actually handles renewals.
# They get their own email ("Hii <name>, the party name is <party>, their
# plan is expiring in just <days> days...") for every 15/10/5-day milestone,
# in addition to (and independent of) the client's own reminder email.
EMPLOYEE_NAME=Employee Name
EMPLOYEE_EMAIL=employee@example.com

# Set to a cron expression to auto-run the reminder check.
# Default below runs once a day at 9:00 AM server time.
REMINDER_CRON=0 9 * * *
